  <option value="Cancelled" ${order.status === "Cancelled" ? "selected" : ""}>Cancelled</option>
</select>
        <p>Payment: ${escapeHTML(order.payment_status)}</p>
        <label>Update Payment Status:</label>
<select onchange="updatePaymentStatus('${escapeHTML(order.id)}', this.value)">
  <option value="Unpaid" ${order.payment_status === "Unpaid" ? "selected" : ""}>Unpaid</option>
  <option value="Paid" ${order.payment_status === "Paid" ? "selected" : ""}>Paid</option>
</select>
        <p>M-Pesa Transaction Code: ${escapeHTML(order.mpesa_receipt_number || "Not provided")}</p>
        <p>Total: KES ${Number(order.total).toLocaleString("en-KE")}</p>
        <h4>Items</h4>
        ${items.map(item => `
          <p>${escapeHTML(item.product_name)} — Quantity: ${Number(item.quantity)}</p>
        `).join("")}
      </div>`;
  }
  }
  async function updateOrderStatus(orderId, newStatus) {
  const allowedStatuses = [
    "Pending",
    "Processing",
    "Shipped",
    "Delivered",
    "Cancelled"
  ];

  if (!allowedStatuses.includes(newStatus)) {
    alert("Invalid order status.");
    return;
  }

  const { data: admin, error: adminError } =
    await db.rpc("is_admin");

  if (adminError || admin !== true) {
    alert("Administrator access required.");
    return;
  }

  const { error } = await db
    .from("orders")
    .update({ status: newStatus })
    .eq("id", orderId);

  if (error) {
    alert("Could not update order: " + error.message);
    return;
  }

  alert("Order status updated successfully!");
  loadAdminOrders();
  }
  async function updatePaymentStatus(orderId, newStatus) {
  if (!["Paid", "Unpaid"].includes(newStatus)) {
    alert("Invalid payment status.");
    return;
  }

  const { data: admin, error: adminError } =
    await db.rpc("is_admin");

  if (adminError || admin !== true) {
    alert("Administrator access required.");
    return;
  }

  const { error } = await db
    .from("orders")
    .update({ payment_status: newStatus })
    .eq("id", orderId);

  if (error) {
    alert("Could not update payment: " + error.message);
    return;
  }

  alert("Payment status updated successfully!");
  loadAdminOrders();
  }
async function addProduct() {
  const name = document.getElementById("productName").value.trim();
  const description = document.getElementById("productDescription").value.trim();
  const price = Number(document.getElementById("productPrice").value);
  const stock = Number(document.getElementById("productStock").value);
  const category_id = document.getElementById("adminCategory").value;
  const imageFile = document.getElementById("productImage").files[0];
let image_url = null;
  const result = document.getElementById("adminMessage");

  if (!name || !category_id || !Number.isFinite(price) ||
      price <= 0 || !Number.isInteger(stock) || stock < 0) {
    result.textContent = "Enter a name, category, valid price and stock quantity.";
    return;
  }


  result.textContent = "Saving product...";
  if (imageFile) {
  const fileExt = imageFile.name.split(".").pop();
  const fileName = `${Date.now()}.${fileExt}`;

  const { data: uploadData, error: uploadError } = await db.storage
    .from("product-images")
    .upload(fileName, imageFile);

  if (uploadError) {
    result.textContent = "Image upload failed: " + uploadError.message;
    return;
  }

  const { data: publicData } = db.storage
    .from("product-images")
    .getPublicUrl(uploadData.path);

  image_url = publicData.publicUrl;
  }

  const { data: admin, error: adminError } = await db.rpc("is_admin");

  if (adminError || admin !== true) {
    result.textContent = "Administrator access required.";
    return;
  }

  const { error } = await db.from("products").insert({
    name,
    description,
    price,
    stock,
    category_id,
    image_url: image_url || null,
    is_active: true
  });

  if (error) {
    result.textContent = "Could not save: " + error.message;
    return;
  }

  result.textContent = "Product saved successfully!";
  document.getElementById("productName").value = "";
  document.getElementById("productDescription").value = "";
  document.getElementById("productPrice").value = "";
  document.getElementById("productStock").value = "";
  document.getElementById("productImage").value = "";

  loadProducts();
}

  async function loadMyOrders() {
  const container = document.getElementById("myOrders");
  container.textContent = "Loading your orders...";

  const { data: sessionData } = await db.auth.getSession();
  const user = sessionData.session?.user;

  if (!user) {
    container.textContent = "Please log in to view your orders.";
    return;
  }

  const { data: orders, error } = await db
    .from("orders")
    .select("id, created_at, status, total, payment_status")
    .eq("user_id", user.id)
    .order("created_at", { ascending: false });

  if (error) {
    container.textContent = "Could not load orders: " + error.message;
    return;
  }

  if (!orders.length) {
    container.textContent = "You have not placed any orders yet.";
    return;
  }

  container.innerHTML = "<h3>Your Order History</h3>";

  for (const order of orders) {
    const { data: items, error: itemsError } = await db
      .from("order_items")
      .select("product_name, quantity, unit_price")
      .eq("order_id", order.id);

    if (itemsError) {
      container.textContent = "Could not load order items: " + itemsError.message;
      return;
    }

    container.innerHTML += `
      <div class="card">
        <p><strong>Order:</strong> ${escapeHTML(order.id)}</p>
        <p><strong>Date:</strong> ${new Date(order.created_at).toLocaleString()}</p>
        <p><strong>Order Progress:</strong></p>
<p style="font-size:18px;font-weight:bold;color:green;">
  ${escapeHTML(order.status)}
</p>
<p>
  ${order.status === "Pending" ? "Your order has been received." : ""}
  ${order.status === "Processing" ? "Your order is being prepared." : ""}
  ${order.status === "Shipped" ? "Your order is on its way." : ""}
  ${order.status === "Delivered" ? "Your order has been delivered." : ""}
  ${order.status === "Cancelled" ? "This order has been cancelled." : ""}
</p>
        <p><strong>Payment:</strong> ${escapeHTML(order.payment_status)}</p>
        <p><strong>Total:</strong> KES ${Number(order.total).toLocaleString("en-KE")}</p>
        <h4>Items</h4>
        ${items.map(item => `
          <p>${escapeHTML(item.product_name)} — Quantity: ${Number(item.quantity)} — KES ${Number(item.unit_price).toLocaleString("en-KE")}</p>
        `).join("")}
      </div>`;
  }
  }
  function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, c => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  }[c]));
}


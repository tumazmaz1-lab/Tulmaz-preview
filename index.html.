async function loadProducts() {
  const message = document.getElementById("productMessage");
  const list = document.getElementById("productList");
  const category = document.getElementById("categoryFilter").value;

  message.textContent = "Loading products...";
  list.innerHTML = "";

  let query = db
    .from("products")
    .select("id, name, description, price, stock, image_url, category_id")
    .eq("is_active", true)
    .order("created_at", { ascending: false });

  if (category) query = query.eq("category_id", category);

  const { data, error } = await query;

  if (error) {
    message.textContent = error.message;
    return;
  }

  message.textContent = data.length
    ? `${data.length} products found`
    : "No products available yet.";

  data.forEach(product => {
    const image = product.image_url &&
      /^https?:\/\//i.test(product.image_url)
      ? `<img src="${escapeHTML(product.image_url)}"
          alt="${escapeHTML(product.name)}"
          style="width:100%;max-height:200px;object-fit:contain">`
      : "";

    list.innerHTML += `
  <div class="card">
    ${image}
    <h3>${escapeHTML(product.name)}</h3>
    <p>${escapeHTML(product.description || "")}</p>
    <p><strong>Price: KES ${Number(product.price).toLocaleString("en-KE")}</strong></p>
    <p>Stock available: ${Number(product.stock)}</p>
    <button onclick="addToCart('${escapeHTML(product.id)}')">
      Add to Cart
    </button>
  </div>`;
  });
}
async function addToCart(productId) {
  const { data: product, error } = await db
    .from("products")
    .select("id, name, price, stock")
    .eq("id", productId)
    .single();

  if (error || !product) {
    alert("Could not find this product.");
    return;
  }

  const existing = cart.find(item => item.id === product.id);

  if (existing) {
    if (existing.quantity >= product.stock) {
      alert("No more stock available.");
      return;
    }
    existing.quantity++;
  } else {
    if (product.stock < 1) {
      alert("This product is out of stock.");
      return;
    }
    cart.push({ ...product, quantity: 1 });
  }

  showCart();
}

function showCart() {
  const container = document.getElementById("cartItems");
  const totalElement = document.getElementById("cartTotal");

  if (!cart.length) {
    container.textContent = "Your cart is empty.";
    totalElement.textContent = "Subtotal: KES 0";
    return;
  }

  let total = 0;
  container.innerHTML = "";

  cart.forEach(item => {
    total += Number(item.price) * item.quantity;

    container.innerHTML += `
      <div class="card">
        <strong>${escapeHTML(item.name)}</strong>
        <p>Quantity: ${item.quantity}</p>
        <p>Price: KES ${Number(item.price).toLocaleString("en-KE")}</p>
        <button onclick="changeQuantity('${escapeHTML(item.id)}', -1)">−</button>
        <button onclick="changeQuantity('${escapeHTML(item.id)}', 1)">+</button>
      </div>`;
  });

  totalElement.textContent =
    "Subtotal: KES " + total.toLocaleString("en-KE");
}

async function changeQuantity(productId, amount) {
  const item = cart.find(product => String(product.id) === String(productId));
  if (!item) return;

  const newQuantity = item.quantity + amount;

  if (newQuantity < 1) {
    cart = cart.filter(product => String(product.id) !== String(productId));
  } else if (newQuantity > item.stock) {
    alert("No more stock available.");
    return;
  } else {
    item.quantity = newQuantity;
  }

  showCart();
}

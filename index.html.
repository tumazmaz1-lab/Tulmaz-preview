db.auth.onAuthStateChange((event, session) => {
  if (event === "PASSWORD_RECOVERY") {
    document.getElementById("resetPasswordBox").style.display = "block";
    showMessage("Enter your new password below.");
  }
});

async function saveNewPassword() {
  const password = document.getElementById("newPassword").value;

  if (password.length < 8) {
    showMessage("Password must be at least 8 characters.");
    return;
  }

  const { error } = await db.auth.updateUser({ password });

  if (error) {
    showMessage(error.message);
    return;
  }

  document.getElementById("resetPasswordBox").style.display = "none";
  document.getElementById("newPassword").value = "";
  showMessage("Password changed successfully! You can now log in.");
}
async function signUp() {
  const name = document.getElementById("signupName").value.trim();
  const email = document.getElementById("signupEmail").value.trim();
  const password = document.getElementById("signupPassword").value;

  if (!name || !email || password.length < 8) {
    showMessage("Enter your name, email and a password of at least 8 characters.");
    return;
  }

  showMessage("Creating your account...");

  const {data, error} = await db.auth.signUp({
    email,
    password,
    options: {data: {full_name: name}}
  });

  if (error) {
    showMessage(error.message);
    return;
  }

  if (data.session) {
    showMessage("Account created successfully!");
    updateScreen(data.session.user);
  } else {
    showMessage("Account created! Check your email to confirm, then log in.");
  }
}

async function logIn() {
  const email = document.getElementById("loginEmail").value.trim();
  const password = document.getElementById("loginPassword").value;

  showMessage("Signing in...");

  const {data, error} = await db.auth.signInWithPassword({
    email,
    password
  });

  if (error) {
    showMessage(error.message);
    return;
  }

  showMessage("Login successful!");
  updateScreen(data.user);
}

